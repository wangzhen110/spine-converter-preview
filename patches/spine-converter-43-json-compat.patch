+bool containsSpine43OnlyField(const Json& value, std::string& field) {
+    if (value.is_object()) {
+        for (auto it = value.begin(); it != value.end(); ++it) {
+            if (it.key() == "slider" || it.key() == "drawOrderFolder" || it.key() == "scaleYMode") {
+                field = it.key();
+                return true;
+            }
+            if (containsSpine43OnlyField(it.value(), field)) return true;
+        }
+    } else if (value.is_array()) {
+        for (const auto& item : value) {
+            if (containsSpine43OnlyField(item, field)) return true;
+        }
+    }
+    return false;
+}
